# Copy to .env and fill in. Never commit .env.
# Read by docker compose and by `python -m insurance_claims` (local runs).

# OpenAI token, server side only. Required when MODEL_PROVIDER=openai; may stay empty with "fake".
OPENAI_API_KEY=

# Optional Fernet key for the encrypted session store. Leave empty for a demo: the app then
# generates a key inside its data directory. For a real deployment set it here, keep it outside
# the data volume, and do not change it once sessions exist. Generate one with:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
STATE_ENCRYPTION_KEY=

# Optional settings (uncomment to change; see apps/insurance_claims/README.md for the full list).
# Host port for docker compose (default 8000):
# PORT=8000
# OPENAI_MODEL=gpt-5.6-luna
# "openai", or "fake" for the offline deterministic demo model:
# MODEL_PROVIDER=openai
# outbox (local demo, nothing delivered) | smtp | disabled:
# EMAIL_TRANSPORT=outbox
# Freeze "today" for demos:
# APP_TODAY=2026-10-03
# development | production (production requires STATE_ENCRYPTION_KEY and HTTPS for the cookie):
# APP_ENV=development
